# ==============================================================================
# Lead Qualification CRM — Environment Configuration (per client deployment)
# ==============================================================================
# Local development: copy to `.env.local`. With nothing set, the app runs as an
# open local demo (JSON file storage, mock AI, emails disabled).
#
# Production (NODE_ENV=production) REQUIRES sections 1 and 2. Without them the
# operator workspace is locked and no data is stored.

# ------------------------------------------------------------------------------
# 1. Database (REQUIRED in production)
# ------------------------------------------------------------------------------
# Any Postgres connection string. On Supabase use the "Transaction pooler"
# string (port 6543) from Project Settings → Database. The table is created
# automatically on first use (see supabase/migrations/002_*.sql).
DATABASE_URL=
# Optional: force SSL on/off (default: on for remote hosts, off for localhost)
# DATABASE_SSL=require
# Optional: start a fresh database with the 8 fictional demo leads (default: false)
# SEED_DEMO_DATA=false
# Optional escape hatch: allow .data/db.json in production on a server with a
# persistent disk (NOT for Vercel/serverless — data would be lost).
# ALLOW_LOCAL_FILE_STORE=false

# ------------------------------------------------------------------------------
# 2. Operator login (REQUIRED in production)
# ------------------------------------------------------------------------------
# Generate an entry with:  npm run hash-password -- coach@theirdomain.com --with-secret
# Multiple operators: comma-separated.
CRM_OPERATORS=
# Random string, at least 32 characters. Changing it logs everyone out.
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 3. OpenRouter AI qualification (optional — falls back to the labelled mock)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000
# Optional comma-separated backup models, tried in order if the main one is busy or fails
OPENROUTER_FALLBACK_MODELS=

# ------------------------------------------------------------------------------
# 4. Email sending (optional — draft-only until configured)
# ------------------------------------------------------------------------------
# Supported provider: resend. The FROM domain must be verified in Resend
# (SPF + DKIM records), otherwise sends are rejected.
EMAIL_PROVIDER=disabled
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Optional: where replies go (e.g. the coach's own inbox)
EMAIL_REPLY_TO=

# ------------------------------------------------------------------------------
# 5. Make.com webhooks (optional — disabled by default)
# ------------------------------------------------------------------------------
MAKE_WEBHOOK_ENABLED=false
MAKE_WEBHOOK_URL=
# Shared secret for outbound HMAC signatures and inbound authentication.
# Use a random string of 32+ characters.
MAKE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 6. Client profile and demo tools
# ------------------------------------------------------------------------------
# Which clients/<id>.ts to build. Branding, services, form text, emails and the
# privacy link all live in that file — not in env vars.
CLIENT_ID=george-stern
# Show demo controls (simulate inquiry, reset demo data) in production.
# Leave false for real client deployments; true only for sales demos.
ENABLE_DEMO_TOOLS=false
